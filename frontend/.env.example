# Base URL of the Django API. In development Vite proxies /api to http://127.0.0.1:8000.
VITE_API_BASE_URL=/api/v1

# Oweru support WhatsApp number in international format without "+" (used for click-to-chat links).
VITE_SUPPORT_WHATSAPP=255711890764

# Free ArcGIS Location Platform API key for satellite imagery (project decision D2).
# Without it, development uses Esri's public tile service.
VITE_ESRI_API_KEY=
