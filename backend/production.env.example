# Template only: no real credentials. Runtime environment/secret store supplies values.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=
ALLOWED_HOSTS=api.example.invalid
MARKETPLACE_PUBLIC_URL=https://market.example.invalid
PASSWORD_RESET_URL=https://market.example.invalid/reset-password
EMAIL_VERIFICATION_URL=https://market.example.invalid/verify-email
OWNER_CONFIRMATION_URL=https://market.example.invalid/confirm
CORS_ALLOWED_ORIGINS=https://market.example.invalid
CSRF_TRUSTED_ORIGINS=https://market.example.invalid
POSTGRES_DB=oweru_marketplace
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=
REDIS_URL=rediss://:REPLACE@redis.example.invalid:6379/0
CELERY_BROKER_URL=rediss://:REPLACE@redis.example.invalid:6379/1
CELERY_RESULT_BACKEND=rediss://:REPLACE@redis.example.invalid:6379/2
MEDIA_STORAGE_BACKEND=s3
MEDIA_STORAGE_BUCKET=
MEDIA_STORAGE_ENDPOINT=
MEDIA_SIGNED_URL_TTL_SECONDS=300
AWS_DEFAULT_REGION=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Only enable after the ingress strips client Forwarded/X-Forwarded-* headers,
# sets its own scheme, and prevents direct access to the application port.
TRUST_PROXY_SSL_HEADER=false
TRUSTED_PROXY_IPS=127.0.0.1
WEB_WORKERS=2
WEB_THREADS=2
LOG_LEVEL=INFO
